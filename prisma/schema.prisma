generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
}

model Company {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String
  name                 String
  logoUrl              String?
  // How the logo is backed where contrast is poor: "auto" (detected),
  // "light" (logo is made for light backgrounds), or "dark" (made for dark).
  logoBackdrop         String           @default("auto")
  profilePicUrl        String?
  phone                String?
  website              String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  contactName          String?
  timezone             String           @default("UTC")
  businessType         String?
  onboardingStep       Int              @default(1)
  onboardingCompletedAt DateTime?
  subscriptionPlan     String           @default("STARTER")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeConnectAccountId String?
  trialEndsAt          DateTime?
  emailVerified        Boolean          @default(false)
  emailVerificationToken String?        @unique
  passwordResetToken   String?          @unique
  passwordResetExpires DateTime?
  customEmailDomain     String?
  customEmailFromName   String?
  resendDomainId        String?
  emailDomainVerified   Boolean          @default(false)
  emailDomainDnsRecords Json?
  customWidgetDomain    String?          @unique
  customWidgetDomainVerified Boolean     @default(false)
  customWidgetDomainVerification Json?
  isAdmin              Boolean          @default(false)
  // God Mode / Qalt Data Operations. Separate from isAdmin so normal platform
  // admins do NOT get super-admin powers (e.g. self plan override).
  isSuperAdmin         Boolean          @default(false)
  lastLoginAt          DateTime?
  registrationSource   String?
  registrationReferrer String?
  registrationLandingPage String?
  registrationUtmSource String?
  registrationUtmMedium String?
  registrationUtmCampaign String?
  registrationUtmTerm   String?
  registrationUtmContent String?
  createdAt            DateTime         @default(now())
  // NOTE: a DB-level functional unique index "Company_email_lower_key" on
  // lower(email) enforces case-insensitive email uniqueness. Prisma cannot model
  // functional indexes, so it lives in the DB only (applied via manual migration).
  pricingProfiles      PricingProfile[]
  quoteRequests        QuoteRequest[]
  widgetSettings       WidgetSettings[]
  vehicleRequests      VehicleRequest[]
  webhooks             Webhook[]
  shopifyInstalls      ShopifyInstall[]
  stopNotes            StopNote[]
  jobs                 Job[]
  customerDocuments    CustomerDocument[]
  widgetInstallations  WidgetInstallation[]
}

model PricingProfile {
  id                String          @id @default(cuid())
  companyId         String
  widgetSettingsId  String?         @unique
  baseRatePerMile   Float           @default(2.50)
  minimumCharge     Float           @default(35.00)
  useMinimumCharge  Boolean         @default(true)
  minMilesThreshold Float           @default(0)
  weightFee         Float           @default(0)
  itemCountFee      Float           @default(0)
  additionalStopFee Float           @default(10.00)
  stairsFee         Float           @default(0)
  insideDeliveryFee Float           @default(0)
  addon3Fee         Float           @default(0)
  afterHoursFee     Float           @default(0)
  businessHoursStart String         @default("08:00")
  businessHoursEnd   String         @default("18:00")
  businessDays       String         @default("1,2,3,4,5")
  largeItemFee       Float          @default(0)
  largeItemsEnabled  Boolean        @default(false)
  largeItemCategories Json          @default("[]")
  serviceOptions      Json           @default("[]")
  company            Company        @relation(fields: [companyId], references: [id])
  widgetSettings     WidgetSettings? @relation(fields: [widgetSettingsId], references: [id])
}

model WidgetSettings {
  id                 String          @id @default(cuid())
  companyId          String
  name               String          @default("Default Form")
  formStyle          String          @default("standard") // "standard" | "extended" | "quick"
  customQuestions    Json            @default("[]")
  logoUrl            String?
  faviconUrl         String?
  // Optional dark variant generated from the uploaded logo. Original artwork is
  // always preserved and remains the default. Merchants explicitly opt in to
  // using this variant on light backgrounds/PDFs.
  logoDarkUrl         String?
  autoContrastLogo    Boolean         @default(false)
  showWeight         Boolean         @default(false)
  showItemCount      Boolean         @default(true)
  showExtras         Boolean         @default(true)
  insideDeliveryLabel String         @default("Inside Delivery")
  addon3Label        String          @default("")
  primaryColor       String          @default("#1E40AF")
  buttonText         String          @default("Get Instant Quote")
  headerText         String          @default("Delivery Quote Calculator")
  quickSubtitleText  String          @default("Enter the route, choose a vehicle, and see your price.")
  disclaimerText     String          @default("Estimate only. Final price confirmed after booking.")
  companyNameText    String?
  companyNameFont    String          @default("Inter")
  backgroundImageUrl String?
  mapLayout          String          @default("inline")
  websiteUrl         String?
  paymentsEnabled    Boolean         @default(false) // Enterprise only
  showVehicles       Boolean         @default(false)
  pricePerVehicle    Float           @default(0)
  vehicleOptions     Json            @default("[]")
  showAwb            Boolean         @default(false)
  geoFencingEnabled  Boolean         @default(false)
  serviceZips        String[]        @default([])
  company            Company         @relation(fields: [companyId], references: [id])
  pricingProfile     PricingProfile?
  widgetInstallations WidgetInstallation[]
}

model WidgetInstallation {
  id          String         @id @default(cuid())
  companyId   String
  formId      String
  domain      String
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  loadCount   Int            @default(1)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form        WidgetSettings @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([companyId, formId, domain])
  @@index([companyId, lastSeenAt])
}

model QuoteRequest {
  id                    String    @id @default(cuid())
  companyId             String
  customerName          String
  customerEmail         String
  customerPhone         String?
  pickupZip             String
  dropoffZip            String
  // Full canonical addresses used for the authoritative route/distance. Nullable
  // so legacy rows (which only stored ZIPs) stay valid. Preserved so future Quote
  // PDFs / Invoices show the exact address that produced the quote.
  pickupAddress         String?
  dropoffAddress        String?
  // Ordered intermediate route stops between pickup and final drop-off.
  // Stored as [{ address, zip }] so the exact quoted route remains historical.
  intermediateStops     Json      @default("[]")
  distanceMiles         Float
  serviceType           String
  packageSize           String?
  packageWeight         String?
  itemCount             Int?
  selectedExtras        String?
  status                String    @default("PENDING")
  estimatedPrice        Float
  // Server-authoritative pricing breakdown snapshot (total, lineItems, freeMiles,
  // billableMiles, minimumApplied, distanceMiles) captured at quote time so
  // documents stay historically accurate even if the merchant later changes rates.
  pricingBreakdown      Json?
  vehicleCount          Int?
  vehicleType           String?
  awbNumber             String?
  paymentStatus         String?   // "PENDING" | "PAID" | "FAILED" | null (null = no payment required)
  stripePaymentIntentId String?
  internalNotes         String?   @db.Text
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  deletedAt             DateTime?
  company               Company   @relation(fields: [companyId], references: [id])
  jobs                  Job[]
  customerDocuments     CustomerDocument[]
}

model Webhook {
  id        String   @id @default(cuid())
  companyId String
  url       String
  secret    String
  events    String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model ShopifyInstall {
  id            String   @id @default(cuid())
  shop          String   @unique
  accessToken   String
  companyId     String?
  scriptTagId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company? @relation(fields: [companyId], references: [id])
}

/// A merchant asking Qalt to add a vehicle to the shared catalog. Added vehicles
/// become available to every merchant.
model VehicleRequest {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleName  String
  description  String   @db.Text
  referenceUrl String?
  status       String   @default("NEW") // NEW, IN_PROGRESS, ADDED, DECLINED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

/// One row per distinct bug: repeats of the same error are grouped by
/// fingerprint and counted. Written by src/lib/error-triage.ts.
model AppError {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  source      String   // "client" or "server"
  message     String   @db.Text
  stack       String?  @db.Text
  path        String?
  userAgent   String?
  companyId   String?
  count       Int      @default(1)
  status      String   @default("NEW") // NEW, INVESTIGATING, FIXED, IGNORED
  severity    String?  // low, medium, high, critical (AI triage)
  aiSummary   String?  @db.Text
  aiCause     String?  @db.Text
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([status, lastSeen])
}

/// One row per alert email or AI triage attempt. Shared across server
/// instances so the hourly alert cap and AI budget survive restarts.
model MonitorEvent {
  id           String   @id @default(cuid())
  kind         String   // "alert" or "ai_attempt"
  errorId      String?
  detail       String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

model PartnerInquiry {
  id              String   @id @default(cuid())
  companyName     String
  website         String?
  contactName     String
  email           String
  partnershipType String   // "Technology", "Referral", "Logistics", "Other"
  message         String   @db.Text
  status          String   @default("NEW") // "NEW", "CONTACTED", "PARTNERED", "REJECTED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StopNote {
  id              String           @id @default(cuid())
  companyId       String
  companyName     String
  address         String
  contactName     String?
  contactPhone    String?
  gateCode        String?
  dockInfo        String?
  hours           String?
  parkingNotes    String?          @db.Text
  accessNotes     String?          @db.Text
  deliveryNotes   String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id])
  readinessChecks ReadinessCheck[]
  exceptionLogs   ExceptionLog[]
  jobStops        JobStop[]
}

model ReadinessCheck {
  id               String   @id @default(cuid())
  stopNoteId       String
  scheduledDate    DateTime
  contactConfirmed Boolean  @default(false)
  addressConfirmed Boolean  @default(false)
  accessConfirmed  Boolean  @default(false)
  siteReady        Boolean  @default(false)
  notes            String?  @db.Text
  status           String   @default("NEEDS_REVIEW") // "READY", "NEEDS_REVIEW", "ISSUE"
  createdAt        DateTime @default(now())
  stopNote         StopNote @relation(fields: [stopNoteId], references: [id])
  jobId            String?
  job              Job?     @relation(fields: [jobId], references: [id])
}

model ExceptionLog {
  id         String   @id @default(cuid())
  stopNoteId String?
  type       String   // "Customer not ready", "Wrong address", "No access", etc.
  notes      String?  @db.Text
  timestamp  DateTime @default(now())
  stopNote   StopNote? @relation(fields: [stopNoteId], references: [id])
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
}

model Job {
  id              String           @id @default(cuid())
  companyId       String
  quoteRequestId  String?
  status          String           @default("PENDING") // PENDING, READY, IN_PROGRESS, COMPLETED, ISSUE
  scheduledDate   DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id])
  quoteRequest    QuoteRequest?    @relation(fields: [quoteRequestId], references: [id])
  stops           JobStop[]
  readinessChecks ReadinessCheck[]
  exceptionLogs   ExceptionLog[]
}

model JobStop {
  id         String   @id @default(cuid())
  jobId      String
  stopNoteId String
  order      Int      @default(0)
  job        Job      @relation(fields: [jobId], references: [id])
  stopNote   StopNote @relation(fields: [stopNoteId], references: [id])
}

// Immutable customer-facing document (Quote or Invoice) generated from a
// QuoteRequest. `snapshot` is the source of truth for rendering and must not
// change if the merchant later edits pricing or branding. `type` and `status`
// are Strings (project convention — no Prisma enums): type in {QUOTE, INVOICE},
// status in {DRAFT, ISSUED, PAID}. `number` is the tenant-scoped human-readable
// id (e.g. Q-2026-00124). At most one document per (quoteRequestId, type), so a
// resend/regenerate reuses the same immutable document rather than minting a new
// number. `publicTokenHash` stores only the hash of a future public-link token
// (tokens are not generated in this phase).
model CustomerDocument {
  id              String    @id @default(cuid())
  companyId       String
  quoteRequestId  String
  type            String
  number          String
  status          String    @default("DRAFT")
  snapshot        Json
  version         Int       @default(1)
  publicTokenHash String?   @unique
  createdAt       DateTime  @default(now())
  issuedAt        DateTime?
  paidAt          DateTime?
  lastEmailedAt   DateTime?
  lastViewedAt    DateTime?
  metadata        Json?
  company         Company      @relation(fields: [companyId], references: [id])
  quoteRequest    QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([companyId, number])
  @@unique([quoteRequestId, type])
  @@index([companyId, quoteRequestId])
}

// Tenant-scoped, per-year, per-type counter backing CustomerDocument.number.
// Numbers are allocated with an atomic INSERT ... ON CONFLICT DO UPDATE (see
// src/lib/customer-documents.ts) so concurrent issuances never collide.
// Intentionally has no Prisma relation to Company: it is internal counter
// infrastructure keyed by companyId, kept lean and written only via the allocator.
model DocumentSequence {
  id         String   @id @default(cuid())
  companyId  String
  year       Int
  type       String
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, year, type])
}
